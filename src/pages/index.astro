---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EventRow from '../components/EventRow.astro';
import ComicCard from '../components/ComicCard.astro';
import PhotoMosaic from '../components/PhotoMosaic.astro';
import VideoGrid from '../components/VideoGrid.astro';
import NextShowBar from '../components/NextShowBar.astro';
import { getUpcomingEvents, nextOnSale, eventUrl, nextOpenMicSignup } from '../lib/events';
import { dateParts, parseLocal } from '../lib/dates';
import { settings, isOn, seoFor } from '../lib/settings';
import { HOME_BLOCKS } from '../../shared/schema';

const upcoming = await getUpcomingEvents();
const openMicContact = (await nextOpenMicSignup(upcoming)).url;
const home = settings.home;
/** Топ-шоу недели (выбирается в админке). Отменённое или прошедшее — не показывается. */
const featured = home.featured ? upcoming.find((e) => e.id === home.featured && e.data.status !== 'cancelled') : undefined;
const next = featured ?? nextOnSale(upcoming);
const nextP = next ? dateParts(parseLocal(next.data.start)) : undefined;
const nextSoldOut = next?.data.seats === 'out';

/** Порядок и заголовки блоков главной — из админки. Блоки, которых нет в списке, идут в конце. */
type BlockId = (typeof HOME_BLOCKS)[number];
const DEFAULT_TITLES: Record<BlockId, string> = { afisha: 'Афиша', facts: '', comics: 'Комики', video: 'Видео', photos: 'Как у нас в клубе', openmic: 'Хочешь на сцену?' };
const SECTION_OF: Partial<Record<BlockId, Parameters<typeof isOn>[0]>> = { facts: 'facts', comics: 'comics', video: 'video', photos: 'photos', openmic: 'openmic' };
const ordered = [...home.blocks, ...HOME_BLOCKS.filter((id) => !home.blocks.some((b) => b.id === id)).map((id) => ({ id, title: '' }))];
const blocks = ordered
  .filter((b) => !SECTION_OF[b.id] || isOn(SECTION_OF[b.id]!))
  .map((b) => ({ id: b.id, title: b.title || DEFAULT_TITLES[b.id] }));
const afisha = upcoming.slice(0, 6);
const comics = isOn('comics')
  ? (await getCollection('comedians', ({ data }) => data.visible)).sort((a, b) => a.data.order - b.data.order).slice(0, 8)
  : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ComedyClub',
  name: settings.name,
  url: 'https://permstandup.ru/',
  telephone: settings.phone,
  address: { '@type': 'PostalAddress', addressLocality: settings.city, streetAddress: settings.address, addressCountry: 'RU' },
  sameAs: [settings.links.telegram, settings.links.vk],
};
---
<Base jsonLd={jsonLd} seo={seoFor('home')}>
  <section class="hero">
    <div class:list={['container', 'hero-grid', { 'has-featured': featured }]}>
      <div>
        <p class="kicker muted">{settings.city} · {settings.address} · 18+</p>
        <h1 class="display title">
          <span class="small">Пермский</span>
          <span class="big">Stand up</span>
          <span class="small">клуб</span>
        </h1>
        <p class="lead hero-lead">{settings.texts.heroLead}</p>
      </div>

      {next && nextP ? (
        <div class:list={['card', 'next', { featured }]}>
          {featured && (
            <a class="poster next-poster" href={eventUrl(next)} aria-label={`Подробнее: ${next.data.title}`}>
              {next.data.cover ? <img src={next.data.cover} alt={`Афиша шоу «${next.data.title}»`} /> : <span class="poster-empty"><img src="/logo.svg" alt="" />Обложка появится позже</span>}
            </a>
          )}
          <div class="next-body">
          <div class="eyebrow">{featured ? (home.featuredLabel || 'Главное шоу недели') : 'Ближайшее шоу'}</div>
          <a class="display next-title" href={eventUrl(next)}>{next.data.title}</a>
          {featured && home.featuredText && <p class="next-text">{home.featuredText}</p>}
          <dl class="facts">
            <div><dt>Дата</dt><dd>{nextP.longWithWeekday}</dd></div>
            <div><dt>Начало</dt><dd>{nextP.time}</dd></div>
            {next.data.priceFrom && <div><dt>Билеты</dt><dd>от {next.data.priceFrom.toLocaleString('ru-RU')} ₽</dd></div>}
          </dl>
          {!featured && <p class="muted note">Сбор гостей за 30 минут. Рассадка свободная — компании лучше брать билеты одним заказом.</p>}
          <div class="next-actions">
            {nextSoldOut ? (
              <a class="btn btn-outline btn-lg" href={eventUrl(next)}>Билеты закончились — подробнее</a>
            ) : (
              <>
                <a class="btn btn-primary btn-lg" href={next.data.ticketUrl ?? eventUrl(next)}>Купить билет</a>
                <a class="btn btn-outline btn-lg" href={eventUrl(next)}>Подробнее</a>
              </>
            )}
          </div>
          </div>
        </div>
      ) : (
        <div class="card next">
          <div class="eyebrow">Афиша</div>
          <div class="display next-title">Скоро объявим новые шоу</div>
          <p class="muted note">Анонсы и скидки первыми — в Telegram.</p>
          <a class="btn btn-primary btn-lg" href={settings.links.telegram}>Подписаться в Telegram</a>
        </div>
      )}
    </div>
  </section>

  {blocks.map((b) => {
    switch (b.id) {
      case 'afisha': return (
        afisha.length > 0 && (
    <section class="section" id="afisha">
      <div class="container">
        <div class="section-head">
          <h2 class="display h2">{b.title}</h2>
          <a class="link-more" href="/afisha/">Вся афиша →</a>
        </div>
        <div class="rows">{afisha.map((e) => <EventRow event={e} />)}</div>
      </div>
    </section>
        ));
      case 'facts': return (
        (
    <section class="container facts-grid" aria-label={b.title || 'Коротко о клубе'}>
      {settings.facts.map((f) => (
        <div class="card fact">
          <div class="display fact-t">{f.title}</div>
          <div class="muted">{f.text}</div>
        </div>
      ))}
    </section>
        ));
      case 'comics': return (
        comics.length > 0 && (
    <section class="section" id="comics">
      <div class="container">
        <div class="section-head">
          <h2 class="display h2">{b.title}</h2>
          <a class="link-more" href="/comics/">Все комики →</a>
        </div>
        <div class="comics">{comics.map((c) => <ComicCard comic={c} />)}</div>
      </div>
    </section>
        ));
      case 'video': return <VideoGrid title={b.title} />;
      case 'photos': return <PhotoMosaic title={b.title} />;
      case 'openmic': return (
        (
    <section class="section" id="openmic">
      <div class="container">
        <div class="card cta">
          <div>
            <h2 class="display h3">{b.title}</h2>
            <p class="lead">{settings.texts.openMic}</p>
          </div>
          <div class="cta-actions">
            <a class="btn btn-light btn-lg" href={openMicContact}>Написать ведущему</a>
            <a class="btn btn-outline btn-lg" href="/open-mic/">Правила</a>
          </div>
        </div>
      </div>
    </section>
        ));
    }
  })}

  <NextShowBar slot="after" event={next} />
</Base>

<style>
  .hero {
    background:
      radial-gradient(ellipse 620px 520px at 82% 8%, var(--c-glow), transparent 70%),
      radial-gradient(ellipse 520px 440px at 6% 0%, rgba(var(--c-glow-rgb), .12), transparent 70%);
  }
  .hero-grid {
    display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 48px; align-items: center; padding-block: clamp(48px, 8vw, 96px) clamp(48px, 8vw, 104px);
  }
  @media (max-width: 960px) { .hero-grid { grid-template-columns: minmax(0, 1fr); gap: 32px; } }
  .kicker { font-size: 14px; letter-spacing: .12em; text-transform: uppercase; margin-bottom: 18px; }
  .title { line-height: .92; }
  .title span { display: block; }
  .small { font-size: clamp(34px, 4.5vw, 64px); font-weight: 600; letter-spacing: .08em; }
  .big { font-size: clamp(72px, 9.5vw, 150px); white-space: nowrap; }
  @media (max-width: 960px) { .big { font-size: clamp(72px, 21vw, 150px); } }
  .hero-lead { margin-top: 24px; max-width: 520px; }

  .next { padding: clamp(22px, 3vw, 32px); display: flex; flex-direction: column; gap: 16px; border: 1px solid rgba(244, 241, 234, .12); overflow: hidden; }
  .next.featured {
    border: 2px solid var(--c-accent);
    background: radial-gradient(ellipse 90% 70% at 100% 0%, rgba(var(--c-glow-rgb), .3), transparent 70%), var(--c-surface);
  }
  .next.featured .eyebrow { align-self: flex-start; background: var(--c-accent); color: var(--c-on-accent); border-radius: var(--r-pill); padding: 4px 12px; letter-spacing: .08em; }
  .next-poster { border-radius: var(--r-m); background-color: var(--c-bg); }
  .next-body { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  /* Главное шоу: обложка слева, текст справа — карточка не вытягивается в высоту */
  .hero-grid.has-featured { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); padding-block: clamp(36px, 5vw, 64px); }
  .next.featured { display: grid; grid-template-columns: minmax(180px, 0.9fr) minmax(0, 1.1fr); gap: 24px; align-items: center; }
  .next.featured .next-title { font-size: clamp(28px, 2.6vw, 38px); }
  .next.featured .next-actions { grid-template-columns: 1fr; }
  @media (max-width: 960px) {
    .hero-grid.has-featured { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 560px) {
    .next.featured { grid-template-columns: minmax(0, 1fr); }
    .next.featured .next-poster { max-width: 360px; width: 100%; justify-self: center; }
  }
  .next-text { color: var(--c-text-2); }
  .next-actions { display: grid; grid-template-columns: 1fr auto; gap: 10px; }
  .next-actions > :only-child { grid-column: 1 / -1; }
  @media (max-width: 400px) { .next-actions { grid-template-columns: 1fr; } }
  .next-title { font-size: clamp(32px, 3.4vw, 44px); font-weight: 600; line-height: 1.05; text-decoration: none; }
  .facts { display: flex; flex-wrap: wrap; gap: 12px 28px; margin: 0; }
  .facts dt { color: var(--c-muted); font-size: 14px; }
  .facts dd { margin: 0; font-weight: 600; }
  .note { font-size: 15px; }

  .rows { border-top: 1px solid var(--c-line); }

  .facts-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 16px; padding-block: 16px; }
  .fact { padding: 24px; }
  .fact-t { font-size: 28px; font-weight: 600; margin-bottom: 6px; }

  .comics { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 24px; }

  .cta { padding: clamp(24px, 4vw, 40px); display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  .cta > div:first-child { max-width: 640px; display: flex; flex-direction: column; gap: 12px; }
  .cta-actions { display: flex; gap: 12px; flex-wrap: wrap; }

  @media (max-width: 760px) {
    .facts-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .fact { padding: 16px; font-size: 14px; }
    .fact-t { font-size: 22px; }
    .comics { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .comics :global(.name) { font-size: 20px; }
  }
</style>
