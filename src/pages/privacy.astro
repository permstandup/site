---
/**
 * Страница «Персональные данные». Короткая и честная: сайт сам ничего о посетителях не собирает.
 * Когда появятся данные ИП / будет включена Метрика — заменить на полную политику (152-ФЗ) и показать юристу.
 */
import Base from '../layouts/Base.astro';
import { settings } from '../lib/settings';
import { t } from '../lib/copy';

const updated = '20 октября 2026';
/** Где сейчас размещён сайт (поменять при переезде в Yandex Cloud) */
const HOSTING = 'GitHub Pages (GitHub, Inc.)';
const metrika = Boolean(settings.seo.metrikaId);
const tg = settings.links.telegram;
---
<Base title="Персональные данные" description={`Какие данные посетителей обрабатывает сайт ${settings.name}.`} noindex>
  <article class="container doc">
    <div class="crumbs muted"><a class="muted" href="/contacts/">{t('nav.contacts')}</a> / Персональные данные</div>
    <h1 class="display h2">Персональные данные</h1>
    <p class="muted">Редакция от {updated}</p>

    <h2>Что собирает сайт</h2>
    <p>На сайте нет регистрации, личного кабинета и форм: мы не просим вводить имя, телефон или почту. Сам сайт не ставит cookie{metrika ? ', кроме счётчика статистики (см. ниже)' : ''} и не ведёт учёт посетителей.</p>

    <h2>Сторонние сервисы</h2>
    <ul>
      <li><b>Хостинг.</b> Сайт размещён на {HOSTING}. Как любой хостинг, он технически получает IP-адрес и сведения о браузере при открытии страниц и обрабатывает их по своим правилам.</li>
      <li><b>Яндекс Карты.</b> Карта загружается только после нажатия кнопки «{t('map.show')}». До этого Яндекс ничего не получает.</li>
      {metrika && <li><b>Яндекс Метрика.</b> Обезличенная статистика посещений (ООО «Яндекс»), использует cookie. Их можно отключить в настройках браузера.</li>}
      <li><b>Видео.</b> Ссылки на видео ведут на сайты VK Видео, Rutube или YouTube — данные там обрабатываются по их правилам.</li>
    </ul>

    <h2>Покупка билетов</h2>
    <p>Билеты продаются на Qtickets и Яндекс Афише. Данные, которые вы указываете при покупке, получает и обрабатывает площадка продажи по своей политике — у клуба на сайте их нет.</p>

    <h2>Переписка</h2>
    <p>Если вы пишете клубу или ведущему в Telegram или ВКонтакте (например, чтобы записаться на открытый микрофон или обсудить мероприятие), мы видим ваш профиль и сообщение и используем их только для ответа.</p>

    <h2>Вопросы</h2>
    <p>Напишите нам в Telegram: <a href={tg}>{tg.replace('https://', '')}</a>{settings.phone && <> или позвоните: {settings.phone}</>}.</p>
  </article>
</Base>

<style>
  .doc { max-width: 820px; padding-block: 24px 96px; }
  .crumbs { font-size: 15px; margin-bottom: 24px; }
  .doc h1 { margin-bottom: 8px; }
  .doc h2 { font-size: 21px; font-weight: 600; margin: 36px 0 10px; }
  .doc p, .doc li { color: var(--c-text-2); }
  .doc p + p { margin-top: 10px; }
  .doc ul { padding-left: 20px; display: flex; flex-direction: column; gap: 8px; margin: 0 0 10px; }
</style>
