---
import { getCollection, type CollectionEntry } from 'astro:content';
import { paragraphs } from '../../lib/text';
import Base from '../../layouts/Base.astro';
import EventRow from '../../components/EventRow.astro';
import VideoGrid from '../../components/VideoGrid.astro';
import { getUpcomingEvents } from '../../lib/events';
import { settings, isOn } from '../../lib/settings';

export async function getStaticPaths() {
  const comics = await getCollection('comedians', ({ data }) => data.visible);
  return comics.map((comic) => ({ params: { slug: comic.id }, props: { comic } }));
}

interface Props { comic: CollectionEntry<'comedians'> }
const { comic } = Astro.props;
const c = comic.data;
const bioParas = paragraphs(comic.body);

const shows = (await getUpcomingEvents())
  .filter((e) => e.data.status !== 'cancelled' && e.data.comedians.some((r) => r.id === comic.id));

// Видео: ссылки из карточки комика + ролики из общего списка, где он указан
const own = c.videos.map((url, i) => ({ title: `Выступление ${i + 1}`, url }));
const fromList = isOn('video')
  ? (await getCollection('videos')).filter((v) => v.data.comedian === c.name).map((v) => v.data)
  : [];
const videos = [...fromList, ...own.filter((o) => !fromList.some((f) => f.url === o.url))];

const [first, ...rest] = c.name.split(' ');
const roleLabel = c.role === 'resident' ? 'Резидент клуба' : 'Гость клуба';
const bio = bioParas.join(' ');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: c.name,
  jobTitle: 'Стендап-комик',
  ...(c.city ? { homeLocation: { '@type': 'Place', name: c.city } } : {}),
  sameAs: [c.telegram, c.vk].filter(Boolean),
  memberOf: c.role === 'resident' ? { '@type': 'Organization', name: settings.name } : undefined,
};
---
<Base
  title={`${c.name} — стендап-комик`}
  description={bio && !bio.startsWith('[') ? bio.slice(0, 160) : `${c.name} — ${roleLabel.toLowerCase()}, ${settings.name}. Ближайшие выступления и видео.`}
  activeNav="/comics/"
  ogImage={`/og/comics/${comic.id}.png`}
  jsonLd={jsonLd}
  noindex={!isOn('comics')}
>
  <div class="container crumbs muted"><a class="muted" href="/comics/">Комики</a> / {c.name}</div>

  <section class="container top">
    <div class="ph portrait">
      {c.photo ? <img src={c.photo} alt={c.name} /> : <span>[Портрет: {c.name}]</span>}
    </div>
    <div class="side">
      <span class="badge">{roleLabel}{c.role === 'guest' && c.city ? ` · ${c.city}` : ''}</span>
      <h1 class="display name">
        {rest.length ? <><span class="n1">{first}</span><span class="n2">{rest.join(' ')}</span></> : <span class="n2">{c.name}</span>}
      </h1>
      <div class="lead bio">{bioParas.map((p) => <p>{p}</p>)}</div>
      {(c.telegram || c.vk) && (
        <div class="links">
          {c.telegram && <a class="btn btn-outline" href={c.telegram}>Telegram</a>}
          {c.vk && <a class="btn btn-outline" href={c.vk}>ВКонтакте</a>}
        </div>
      )}
    </div>
  </section>

  <section class="container block">
    <h2 class="display h3">Ближайшие выступления</h2>
    {shows.length > 0 ? (
      <div class="rows">{shows.map((e) => <EventRow event={e} />)}</div>
    ) : (
      <div class="card empty">
        <div>Сейчас в афише нет шоу с участием {c.role === 'resident' ? 'резидента' : 'комика'}. Анонсы — в нашем Telegram.</div>
        <div class="empty-a">
          <a class="btn btn-outline" href="/afisha/">Вся афиша</a>
          <a class="btn btn-outline" href={settings.links.telegram}>Telegram</a>
        </div>
      </div>
    )}
  </section>

  {videos.length > 0 && <VideoGrid items={videos} more={false} />}
  <div class="spacer"></div>
</Base>

<style>
  .crumbs { padding-top: 24px; font-size: 15px; }
  .top {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: clamp(28px, 5vw, 56px); align-items: center; padding-block: 24px 56px;
  }
  .portrait {
    aspect-ratio: 4 / 5; max-width: 520px; width: 100%; border-radius: 24px;
    background: radial-gradient(ellipse 80% 60% at 70% 0%, rgba(var(--c-glow-rgb), .35), transparent 70%), linear-gradient(180deg, var(--c-surface-2), var(--c-surface));
  }
  .side { display: flex; flex-direction: column; gap: 20px; }
  .badge {
    align-self: flex-start; font-size: 14px; font-weight: 600; color: var(--c-on-accent);
    background: var(--c-accent); border-radius: var(--r-pill); padding: 4px 14px;
  }
  .name { line-height: .92; overflow-wrap: anywhere; }
  .name span { display: block; }
  .n1 { font-size: clamp(40px, 4.6vw, 64px); font-weight: 600; }
  .n2 { font-size: clamp(60px, 8vw, 112px); }
  .bio { max-width: 520px; }
  .links { display: flex; gap: 12px; flex-wrap: wrap; }

  .block { padding-block: 24px 40px; }
  .block h2 { margin-bottom: 20px; }
  .rows { border-top: 1px solid var(--c-line); }
  .empty { padding: 24px; display: flex; flex-direction: column; gap: 14px; }
  .empty-a { display: flex; gap: 10px; flex-wrap: wrap; }
  .spacer { height: 56px; }
  @media (max-width: 640px) { .portrait { max-width: none; aspect-ratio: 1; } }
</style>
