---
import Base from '../../layouts/Base.astro';
import ComicCard from '../../components/ComicCard.astro';
import NextShowBar from '../../components/NextShowBar.astro';
import MapBlock from '../../components/MapBlock.astro';
import { getUpcomingEvents, getEventComedians, eventUrl, FORMAT_LABEL, type EventEntry } from '../../lib/events';
import { dateParts, parseLocal } from '../../lib/dates';
import { settings, isOn } from '../../lib/settings';
import { paragraphs } from '../../lib/text';

export async function getStaticPaths() {
  const upcoming = await getUpcomingEvents();
  return upcoming.map((event) => ({ params: { slug: event.id }, props: { event, upcoming } }));
}

interface Props { event: EventEntry; upcoming: EventEntry[] }
const { event, upcoming } = Astro.props;
const d = event.data;
const start = parseLocal(d.start);
const p = dateParts(start);
const cancelled = d.status === 'cancelled';
const moved = d.status === 'moved';
const soldOut = d.seats === 'out';
const from = moved && d.movedFrom ? dateParts(parseLocal(d.movedFrom)) : undefined;
const important = d.important?.length ? d.important : settings.importantDefault;
const comics = isOn('comics') ? await getEventComedians(event) : [];
const others = upcoming.filter((e) => e.id !== event.id && e.data.status !== 'cancelled').slice(0, 3);
const about = paragraphs(event.body);
const price = d.priceFrom ? `от ${d.priceFrom.toLocaleString('ru-RU')} ₽` : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ComedyEvent',
  name: d.title,
  startDate: start.toISOString(),
  eventStatus: cancelled ? 'https://schema.org/EventCancelled' : moved ? 'https://schema.org/EventRescheduled' : 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  ...(moved && d.movedFrom ? { previousStartDate: parseLocal(d.movedFrom).toISOString() } : {}),
  location: {
    '@type': 'Place',
    name: settings.name,
    address: { '@type': 'PostalAddress', addressLocality: settings.city, streetAddress: settings.address, addressCountry: 'RU' },
  },
  organizer: { '@type': 'Organization', name: settings.name, url: 'https://permstandup.ru/' },
  ...(d.priceFrom && d.ticketUrl ? {
    offers: {
      '@type': 'Offer', price: d.priceFrom, priceCurrency: 'RUB', url: d.ticketUrl,
      availability: soldOut ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock',
    },
  } : {}),
  performer: comics.map((c) => ({ '@type': 'Person', name: c!.data.name })),
};
const desc = d.seoDescription ?? `${d.title} — ${p.longWithWeekday}, ${p.time}. ${FORMAT_LABEL[d.format]} в Пермском стендап клубе${price ? `, билеты ${price}` : ''}.`;
---
<Base title={`${d.title}, ${p.long}`} description={desc} ogImage={`/og/shows/${event.id}.png`} activeNav="/afisha/" jsonLd={jsonLd}>
  <div class="container crumbs muted"><a class="muted" href="/afisha/">Афиша</a> / {d.title}</div>

  {(cancelled || moved) && (
    <section class="container">
      {cancelled ? (
        <div class="notice notice-cancel" role="status">
          <span class="tag tag-cancel">Отменено</span>
          <div class="nt">
            <div class="nh">Шоу {p.long} отменено</div>
            <div>{d.cancelReason ? `Причина: ${d.cancelReason}. ` : ''}Деньги за билеты возвращаются через Qtickets. Если не пришли — напишите нам.</div>
          </div>
          <div class="na">
            <a class="btn btn-light" href={d.ticketUrl ?? settings.links.qtickets}>Как вернуть билет</a>
            <a class="btn btn-outline" href={settings.links.telegram}>Написать нам</a>
          </div>
        </div>
      ) : (
        <div class="notice notice-moved" role="status">
          <span class="tag tag-moved">Перенесено</span>
          <div class="nt">
            <div class="nh">Шоу перенесено{from ? ` с ${from.long}` : ''} на {p.long}, {p.time}</div>
            <div>Купленные билеты действуют на новую дату. Если она не подходит — билет можно вернуть через Qtickets.</div>
          </div>
          <div class="na"><a class="btn btn-outline" href={d.ticketUrl ?? settings.links.qtickets}>Вернуть билет</a></div>
        </div>
      )}
    </section>
  )}

  <section class="container top">
    <div class:list={['ph', 'cover', { dim: cancelled }]}>
      {d.cover ? <img src={d.cover} alt={`Афиша шоу «${d.title}»`} /> : <span>[Обложка шоу]</span>}
    </div>
    <div class="side">
      <div class="tags">
        <span class="tag tag-outline">{FORMAT_LABEL[d.format]}</span>
        <span class="tag tag-outline">{d.age}</span>
        {!cancelled && d.seats === 'few' && <span class="tag tag-few">Мало мест</span>}
      </div>
      <h1 class:list={['display', 'h1', { struck: cancelled }]}>{d.title}</h1>
      <dl class="card facts">
        <div><dt>Дата</dt><dd class:list={{ struck: cancelled }}>{p.longWithWeekday}</dd></div>
        <div><dt>Начало</dt><dd>{p.time}</dd></div>
        {price && <div><dt>Билеты</dt><dd>{price}</dd></div>}
      </dl>
      {cancelled ? (
        <a class="btn btn-outline btn-lg" href="/afisha/">Посмотреть другие шоу</a>
      ) : soldOut ? (
        <span class="btn btn-outline btn-lg" aria-disabled="true">Билеты закончились</span>
      ) : d.ticketUrl && (
        <a class="btn btn-primary btn-lg" href={d.ticketUrl}>{moved ? `Купить билет на ${p.long}` : 'Купить билет'}</a>
      )}
      <div class="links">
        <a href={settings.links.yandexAfisha}>Также в Яндекс Афише</a>
        {!cancelled && <a href={`${eventUrl(event)}event.ics`} download>Добавить в календарь</a>}
        <button type="button" class="share" data-share>Поделиться</button>
      </div>
    </div>
  </section>

  <section class="container two">
    <div>
      <h2 class="display h3">О шоу</h2>
      <div class="prose">{about.map((p) => <p>{p}</p>)}</div>
    </div>
    <div>
      <h2 class="display h3">Важно знать</h2>
      <ol class="important">
        {important.map((t) => <li>{t}</li>)}
      </ol>
    </div>
  </section>

  {comics.length > 0 && (
    <section class="container block">
      <h2 class="display h3">Выступают</h2>
      <div class="comics">{comics.map((c) => <ComicCard comic={c!} size="s" />)}</div>
    </section>
  )}

  <section class="container block">
    <h2 class="display h3">Как добраться</h2>
    <MapBlock />
  </section>

  {others.length > 0 && (
    <section class="container block last">
      <h2 class="display h3">Ещё в афише</h2>
      <div class="others">
        {others.map((o) => {
          const op = dateParts(parseLocal(o.data.start));
          return (
            <a class="card other" href={eventUrl(o)}>
              <div class="display ot">{op.day} {op.month} · {op.time}</div>
              <div class="on">{o.data.title}</div>
              <div class="muted">{o.data.priceFrom ? `от ${o.data.priceFrom.toLocaleString('ru-RU')} ₽` : FORMAT_LABEL[o.data.format]}{o.data.seats === 'few' ? ' · мало мест' : o.data.seats === 'out' ? ' · sold out' : ''}</div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  {!cancelled && !soldOut && d.ticketUrl && (
    <NextShowBar slot="after" event={event} label="Купить билет" />
  )}
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((b) => b.addEventListener('click', async () => {
    const data = { title: document.title, url: location.href };
    try {
      if (navigator.share) await navigator.share(data);
      else { await navigator.clipboard.writeText(location.href); b.textContent = 'Ссылка скопирована'; }
    } catch { /* пользователь закрыл окно */ }
  }));
</script>

<style>
  .crumbs { padding-top: 24px; font-size: 15px; }
  .notice {
    margin-top: 24px; border-radius: var(--r-m); padding: 22px 26px; display: flex; gap: 18px; align-items: flex-start; flex-wrap: wrap;
  }
  .notice-cancel { background: #3a1717; border: 1px solid var(--c-cancel); }
  .notice-moved { background: #3a2c10; border: 1px solid var(--c-moved); }
  .nt { flex: 1; min-width: 260px; color: #ead9d0; }
  .nh { font-size: 20px; font-weight: 600; color: var(--c-text); margin-bottom: 4px; }
  .na { display: flex; gap: 10px; flex-wrap: wrap; }

  .top {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: 48px; align-items: start; padding-block: 24px 56px;
  }
  .cover { aspect-ratio: 4 / 3; border-radius: var(--r-l); background: radial-gradient(ellipse 70% 60% at 75% 10%, rgba(var(--c-glow-rgb), .35), transparent 70%), var(--c-surface); }
  .cover.dim { opacity: .5; }
  .side { display: flex; flex-direction: column; gap: 20px; }
  .tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .tags .tag { padding: 4px 12px; border-radius: var(--r-pill); font-size: 14px; }
  .struck { text-decoration: line-through; color: #c9d0cf; }
  .facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; padding: 20px 24px; margin: 0; }
  .facts dt { color: var(--c-muted); font-size: 14px; }
  .facts dd { margin: 0; font-weight: 600; font-size: 19px; }
  .links { display: flex; gap: 8px 20px; flex-wrap: wrap; font-size: 15px; align-items: center; }
  .links a, .share { min-height: 44px; display: inline-flex; align-items: center; }
  .share { background: none; border: 0; color: var(--c-text); font: inherit; text-decoration: underline; cursor: pointer; padding: 0; }

  .two { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); gap: 48px; padding-block: 24px 56px; }
  .two h2, .block h2 { margin-bottom: 18px; }
  .prose { color: var(--c-text-2); }
  .prose :global(p + p) { margin-top: 12px; }
  .important { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--c-line); counter-reset: n; }
  .important li { counter-increment: n; display: flex; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--c-line); }
  .important li::before { content: counter(n, decimal-leading-zero); color: var(--c-accent); font-weight: 600; min-width: 28px; }

  .block { padding-block: 24px 56px; }
  .comics { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 20px; }

  .last { padding-bottom: 96px; }
  .others { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 20px; }
  .other { padding: 22px; text-decoration: none; display: flex; flex-direction: column; gap: 6px; }
  .ot { font-size: 22px; font-weight: 600; color: var(--c-accent); }
  .on { font-size: 19px; font-weight: 600; }

  @media (max-width: 640px) {
    .facts { padding: 16px; gap: 10px; }
    .facts dd { font-size: 16px; }
    .comics { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  }
</style>
