---
import Base from '../layouts/Base.astro';
import EventRow from '../components/EventRow.astro';
import { getUpcomingEvents, groupByWeek } from '../lib/events';
import { settings, seoFor } from '../lib/settings';

const upcoming = await getUpcomingEvents();
const groups = groupByWeek(upcoming);
const filters = [
  { id: 'all', label: 'Все' },
  { id: 'standup', label: 'Стендап-шоу' },
  { id: 'openmic', label: 'Открытый микрофон' },
  { id: 'test', label: 'Проверочные' },
  { id: 'weekend', label: 'Только выходные' },
];
---
<Base title="Афиша" description="Афиша стендап-концертов, открытых микрофонов и проверочных концертов в Пермском стендап клубе." activeNav="/afisha/" seo={seoFor('afisha')}>
  <section class="container head">
    <h1 class="display h1">Афиша</h1>
    <p class="lead intro">Стендап с пятницы по воскресенье, проверочные концерты и открытые микрофоны по будням. Сбор гостей за 30 минут, рассадка свободная.</p>
    {upcoming.length > 0 && (
      <div class="filters" role="group" aria-label="Фильтр афиши">
        {filters.map((f, i) => <button type="button" class="chip" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>)}
      </div>
    )}
  </section>

  <section class="container list">
    {upcoming.length === 0 ? (
      <div class="empty">
        <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="var(--c-accent-hover)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="2" width="6" height="11" rx="3"></rect><path d="M5 10a7 7 0 0 0 14 0M12 17v5M8 22h8"></path></svg>
        <h2 class="display h3">Скоро объявим новые шоу</h2>
        <p class="lead">Комики сейчас готовят новый материал. Подпишитесь на Telegram — анонсы и скидки приходят туда первыми.</p>
        <div class="empty-actions">
          <a class="btn btn-primary btn-lg" href={settings.links.telegram}>Подписаться в Telegram</a>
          <a class="btn btn-outline btn-lg" href={settings.links.vk}>Группа ВКонтакте</a>
        </div>
      </div>
    ) : (
      <>
        {groups.map((g) => (
          <div class="group" data-group>
            <h2 class="eyebrow gname">{g.name}</h2>
            <div class="rows">{g.events.map((e) => <EventRow event={e} />)}</div>
          </div>
        ))}
        <p class="muted nothing" hidden>По этому фильтру ничего нет — загляните в «Все».</p>
        <div class="card sub">
          <div>Афиша обновляется каждую неделю — анонсы и скидки первыми в Telegram.</div>
          <a class="btn btn-outline" href={settings.links.telegram}>Подписаться на канал</a>
        </div>
      </>
    )}
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const rows = document.querySelectorAll<HTMLElement>('[data-format]');
  const groups = document.querySelectorAll<HTMLElement>('[data-group]');
  const nothing = document.querySelector<HTMLElement>('.nothing');
  buttons.forEach((b) => b.addEventListener('click', () => {
    const f = b.dataset.filter;
    buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    rows.forEach((r) => {
      const ok = f === 'all' || (f === 'weekend' ? r.dataset.weekend === '1' : r.dataset.format === f);
      r.hidden = !ok;
    });
    let any = false;
    groups.forEach((g) => {
      const visible = [...g.querySelectorAll<HTMLElement>('[data-format]')].some((r) => !r.hidden);
      g.hidden = !visible;
      any ||= visible;
    });
    if (nothing) nothing.hidden = any;
  }));
</script>

<style>
  .head { padding-top: clamp(40px, 6vw, 56px); }
  .intro { margin: 12px 0 24px; max-width: 640px; }
  .filters { display: flex; gap: 10px; flex-wrap: wrap; }
  .list { padding-block: 32px 96px; }
  .group { margin-bottom: 40px; }
  .gname { margin-bottom: 12px; font-size: 15px; }
  .rows { border-top: 1px solid var(--c-line); }
  .sub { padding: 24px 28px; display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .empty {
    border: 1px dashed rgba(244, 241, 234, .25); border-radius: 24px; padding: clamp(40px, 6vw, 64px) 24px;
    display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center;
    background: radial-gradient(ellipse 50% 80% at 50% 0%, rgba(var(--c-glow-rgb), .18), transparent 70%);
  }
  .empty .lead { max-width: 520px; }
  .empty-actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 8px; }
  @media (max-width: 640px) { .filters { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 4px; } .chip { flex: none; } }
</style>
