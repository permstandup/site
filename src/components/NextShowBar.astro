---
/** Плашка ближайшего шоу внизу экрана на телефоне */
import type { EventEntry } from '../lib/events';
import { dateParts, parseLocal } from '../lib/dates';
interface Props { event?: EventEntry; label?: string; href?: string }
const { event, label = 'Билеты', href } = Astro.props;
const p = event ? dateParts(parseLocal(event.data.start)) : undefined;
const link = href ?? event?.data.ticketUrl;
---
{event && link && p && (
  <div class="bar" role="complementary" aria-label="Ближайшее шоу">
    <div class="txt">
      <div class="t">{event.data.title}</div>
      <div class="muted s">{p.weekday} {p.day} {p.month} · {p.time}{event.data.priceFrom ? ` · от ${event.data.priceFrom.toLocaleString('ru-RU')} ₽` : ''}</div>
    </div>
    <a class="btn btn-primary" href={link}>{label}</a>
  </div>
)}

<style>
  .bar { display: none; }
  @media (max-width: 760px) {
    .bar {
      display: flex; align-items: center; gap: 12px; position: fixed; left: 0; right: 0; bottom: 0; z-index: 15;
      padding: 12px var(--gutter) calc(14px + env(safe-area-inset-bottom));
      background: rgba(var(--c-bar-rgb), .96); border-top: 1px solid var(--c-line);
    }
    .txt { flex: 1; min-width: 0; line-height: 1.3; }
    .t { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .s { font-size: 13px; }
    :global(body) { padding-bottom: 84px; }
  }
</style>
