---
import type { CollectionEntry } from 'astro:content';
interface Props { comic: CollectionEntry<'comedians'>; size?: 'l' | 's' }
const { comic, size = 'l' } = Astro.props;
const c = comic.data;
const roleLabel = c.role === 'resident' ? (c.tagline ?? 'Резидент клуба') : c.city ? `Гость · ${c.city}` : 'Гость клуба';
---
<a href={`/comics/${comic.id}/`} class:list={['comic', `comic-${size}`]}>
  <div class="ph photo">
    {c.photo ? <img src={c.photo} alt={c.name} loading="lazy" /> : <span>[Фото: {c.name}]</span>}
  </div>
  <div class="display name">{c.name}</div>
  <div class="muted role">{roleLabel}</div>
</a>

<style>
  .comic { display: flex; flex-direction: column; gap: 6px; text-decoration: none; color: var(--c-text); }
  .photo { aspect-ratio: 4 / 5; margin-bottom: 8px; }
  .comic-s .photo { aspect-ratio: 1; }
  .name { font-size: 28px; font-weight: 600; line-height: 1.1; }
  .comic-s .name { font-family: var(--f-body); text-transform: none; font-size: 18px; }
  .role { font-size: 15px; }
  .comic:hover .name { color: var(--c-accent-hover); }
</style>
