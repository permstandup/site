---
/** Временный знак: круг с надписью. Заменить на SVG-логотип клуба, когда будет исходник. */
interface Props { size?: 'm' | 's' }
const { size = 'm' } = Astro.props;
---
<a href="/" class:list={['logo', `logo-${size}`]} aria-label="Пермский стендап клуб — на главную">
  <span class="mark" aria-hidden="true">STAND<br />UP<br />PERM</span>
  <span class="name">Пермский<br />стендап клуб</span>
</a>

<style>
  .logo { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--c-text); }
  .mark {
    flex: none; width: 52px; height: 52px; border-radius: 50%; border: 2px solid currentColor;
    display: flex; align-items: center; justify-content: center; text-align: center;
    font-family: var(--f-display); font-weight: 600; font-size: 10px; line-height: 1.05;
  }
  .name {
    font-family: var(--f-display); font-weight: 600; font-size: 20px; letter-spacing: .06em;
    text-transform: uppercase; line-height: 1.1;
  }
  .logo-s .mark { width: 44px; height: 44px; font-size: 8.5px; }
  .logo-s .name { font-size: 16px; }
  @media (max-width: 420px) { .name { font-size: 16px; } .mark { width: 44px; height: 44px; font-size: 8.5px; } }
</style>
