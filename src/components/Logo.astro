---
/** Логотип клуба (векторный, из присланной картинки) + название. */
interface Props { size?: 'm' | 's' }
const { size = 'm' } = Astro.props;
---
<a href="/" class:list={['logo', `logo-${size}`]} aria-label="Пермский стендап клуб — на главную">
  <img class="mark" src="/logo.svg" alt="" width="52" height="52" />
  <span class="name">Пермский<br />стендап клуб</span>
</a>

<style>
  .logo { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--c-text); }
  .mark { flex: none; width: 52px; height: 52px; display: block; }
  .name {
    font-family: var(--f-display); font-weight: 600; font-size: 20px; letter-spacing: .06em;
    text-transform: uppercase; line-height: 1.1;
  }
  .logo-s .mark { width: 44px; height: 44px; }
  .logo-s .name { font-size: 16px; }
  @media (max-width: 420px) { .name { font-size: 16px; } .mark { width: 44px; height: 44px; } }
</style>
