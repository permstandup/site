---
import { getCollection } from 'astro:content';
import { settings } from '../lib/settings';

type Item = { title: string; url: string; comedian?: string; cover?: string };
interface Props { items?: Item[]; title?: string; more?: boolean }
const { items, title = 'Видео', more = true } = Astro.props;
const videos: Item[] = items ?? (await getCollection('videos'))
  .sort((a, b) => a.data.order - b.data.order).slice(0, 6).map((v) => v.data);
const sourceOf = (url: string) =>
  /youtu\.?be/.test(url) ? 'youtube' : /rutube/.test(url) ? 'Rutube' : 'VK Видео';
---
{videos.length > 0 && (
  <section id="video" class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="display h2">{title}</h2>
        {more && <a class="link-more" href={settings.links.vk}>Все записи ВКонтакте →</a>}
      </div>
      <div class="grid">
        {videos.map((v) => {
          const src = sourceOf(v.url);
          const yt = src === 'youtube';
          return (
            <a class="video" href={v.url} target={yt ? '_blank' : undefined} rel={yt ? 'noopener' : undefined}>
              <div class:list={['ph', 'frame', { 'has-cover': v.cover }]}>
                {v.cover && <img src={v.cover} alt="" loading="lazy" decoding="async" />}
                <span class:list={['play', { ghost: yt }]} aria-hidden="true">
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5l11 7-11 7z"></path></svg>
                </span>
              </div>
              <div class="t">{v.title}</div>
              <div class="muted s">{v.comedian ? `${v.comedian} · ` : ''}{yt ? 'ссылка на YouTube ↗' : src}</div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
)}

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 24px; }
  .video { text-decoration: none; color: var(--c-text); display: flex; flex-direction: column; gap: 8px; }
  .frame { aspect-ratio: 16 / 9; background: var(--c-surface); position: relative; overflow: hidden; }
  .frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .3s; }
  .frame.has-cover::after { content: ''; position: absolute; inset: 0; background: rgba(0, 0, 0, .18); }
  .frame .play { position: relative; z-index: 1; }
  .video:hover .frame img { transform: scale(1.03); }
  .play {
    width: 64px; height: 64px; border-radius: 50%; background: var(--c-accent); color: var(--c-on-accent);
    display: flex; align-items: center; justify-content: center;
  }
  .play.ghost { background: rgba(0, 0, 0, .35); border: 2px solid var(--c-text); color: var(--c-text); }
  .t { font-weight: 600; }
  .s { font-size: 14px; }
  .video:hover .play { background: var(--c-accent-hover); }
  @media (max-width: 640px) {
    .grid { display: flex; overflow-x: auto; gap: 12px; scroll-snap-type: x mandatory; padding-bottom: 6px; }
    .video { flex: none; width: 78%; scroll-snap-align: start; }
    .play { width: 52px; height: 52px; }
  }
</style>
