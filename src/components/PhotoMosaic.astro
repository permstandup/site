---
import { getCollection } from 'astro:content';
const photos = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);
const shown = photos.slice(0, 7);
---
<section id="photos" class="section">
  <div class="container">
    <div class="section-head">
      <h2 class="display h2">Как у нас в клубе</h2>
      <p class="muted">Фото с наших вечеров</p>
    </div>
    <div class="mosaic">
      {shown.map((p, i) => (
        <button type="button" class:list={['ph', 'tile', `t${i}`]} data-photo-index={i} aria-label={`Открыть фото: ${p.data.caption}`}>
          {p.data.src ? <img src={p.data.src} alt={p.data.alt} loading="lazy" /> : <span>[{p.data.caption}]</span>}
        </button>
      ))}
      {photos.length > 0 && (
        <button type="button" class="all" data-photo-index="0">Смотреть все фото <span aria-hidden="true">→</span></button>
      )}
    </div>
  </div>

  <dialog class="lightbox" aria-label="Фото из клуба">
    <div class="lb-top">
      <span class="lb-count"></span>
      <button type="button" class="lb-btn" data-close aria-label="Закрыть">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
    <div class="lb-stage">
      <button type="button" class="lb-btn lb-nav" data-prev aria-label="Предыдущее фото">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
      </button>
      <figure class="lb-figure"><div class="ph lb-img"></div><figcaption class="lb-cap"></figcaption></figure>
      <button type="button" class="lb-btn lb-nav" data-next aria-label="Следующее фото">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
      </button>
    </div>
  </dialog>
  <script type="application/json" id="photos-data" set:html={JSON.stringify(photos.map((p) => ({ src: p.data.src ?? '', alt: p.data.alt, caption: p.data.caption, author: p.data.author ?? '' })))} />
</section>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('.lightbox');
  const data: { src: string; alt: string; caption: string; author: string }[] =
    JSON.parse(document.getElementById('photos-data')?.textContent || '[]');
  if (dlg && data.length) {
    let i = 0;
    const img = dlg.querySelector<HTMLElement>('.lb-img')!;
    const cap = dlg.querySelector<HTMLElement>('.lb-cap')!;
    const count = dlg.querySelector<HTMLElement>('.lb-count')!;
    const show = (n: number) => {
      i = (n + data.length) % data.length;
      const p = data[i];
      img.replaceChildren();
      if (p.src) {
        const el = document.createElement('img');
        el.src = p.src; el.alt = p.alt;
        img.append(el);
      } else {
        img.textContent = `[${p.caption}]`;
      }
      cap.textContent = p.author ? `${p.caption} · Фото: ${p.author}` : p.caption;
      count.textContent = `${i + 1} / ${data.length}`;
    };
    document.querySelectorAll<HTMLElement>('[data-photo-index]').forEach((b) =>
      b.addEventListener('click', () => { show(Number(b.dataset.photoIndex)); dlg.showModal(); }));
    dlg.querySelector('[data-close]')?.addEventListener('click', () => dlg.close());
    dlg.querySelector('[data-prev]')?.addEventListener('click', () => show(i - 1));
    dlg.querySelector('[data-next]')?.addEventListener('click', () => show(i + 1));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(i - 1);
      if (e.key === 'ArrowRight') show(i + 1);
    });
    let x0: number | null = null;
    dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    dlg.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) show(dx < 0 ? i + 1 : i - 1);
      x0 = null;
    });
  }
</script>

<style>
  .lightbox {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 16px var(--gutter);
    border: 0; background: rgba(5, 10, 11, .97); color: var(--c-text);
  }
  .lightbox[open] { display: flex; flex-direction: column; gap: 12px; }
  .lightbox::backdrop { background: rgba(0, 0, 0, .6); }
  .lb-top { display: flex; justify-content: space-between; align-items: center; }
  .lb-count { color: var(--c-muted); font-size: 15px; }
  .lb-stage { flex: 1; min-height: 0; display: flex; align-items: center; gap: 16px; }
  .lb-figure { flex: 1; min-width: 0; height: 100%; margin: 0; display: flex; flex-direction: column; gap: 12px; }
  .lb-img { flex: 1; min-height: 0; border-radius: 8px; }
  .lb-img :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .lb-cap { color: var(--c-text-2); font-size: 15px; text-align: center; }
  .lb-btn {
    flex: none; width: 48px; height: 48px; border-radius: 50%; border: 0; cursor: pointer;
    background: rgba(244, 241, 234, .12); color: var(--c-text); display: flex; align-items: center; justify-content: center;
  }
  @media (max-width: 640px) { .lb-nav { display: none; } }
</style>

<style>
  .mosaic { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: 210px; gap: 12px; }
  .tile { border: 0; padding: 0; cursor: zoom-in; font: inherit; width: 100%; height: 100%; }
  .t0 { grid-column: span 2; grid-row: span 2; background: radial-gradient(ellipse 70% 70% at 70% 10%, rgba(150,95,255,.3), transparent 70%), var(--c-tile); }
  .t5 { grid-column: span 2; }
  .all {
    grid-column: span 2; border-radius: var(--r-m); border: 1px solid var(--c-line); background: var(--c-surface);
    color: var(--c-text); font: inherit; font-weight: 600; font-size: 18px; cursor: pointer;
  }
  .all span { color: var(--c-accent); }
  .all:hover { border-color: var(--c-accent); }
  @media (max-width: 760px) {
    .mosaic { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 150px; gap: 8px; }
    .t5 { grid-column: span 1; }
    .all { grid-column: span 1; font-size: 15px; }
  }
</style>
