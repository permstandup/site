---
import { BG_VALUES } from '../../shared/themes';
import '@fontsource/oswald/500.css';
import '@fontsource/oswald/600.css';
import '@fontsource/oswald/700.css';
import '@fontsource/golos-text/400.css';
import '@fontsource/golos-text/500.css';
import '@fontsource/golos-text/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import Metrika from '../components/Metrika.astro';
import { settings } from '../lib/settings';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  activeNav?: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  /** Заголовок и описание из админки (Настройки → SEO); пустые — не используются */
  seo?: { title?: string; description?: string };
}
const { title, description, ogImage, activeNav, jsonLd, noindex = false, seo } = Astro.props;
const fullTitle = seo?.title || (title ? `${title} — ${settings.name}` : `${settings.name} — стендап в Перми`);
const desc = seo?.description || description || settings.texts.heroLead;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(ogImage ?? '/og/default.png', Astro.site).toString();
---
<!doctype html>
<html lang="ru" data-theme={settings.theme} data-bg={settings.background}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={BG_VALUES[settings.background].bg} />
    {settings.seo.yandexVerification && <meta name="yandex-verification" content={settings.seo.yandexVerification} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={settings.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline src="/vt.js"></script>
    <link rel="expect" href="#vt-poster" blocking="render" />
  </head>
  <body>
    <a class="skip-link" href="#main">К содержимому</a>
    <Banner />
    <Header active={activeNav} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <slot name="after" />
    <Metrika />
    <script>
    // Блоки ниже первого экрана мягко проявляются при прокрутке (один раз)
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      const items = [...document.querySelectorAll<HTMLElement>('main > section, main > div:not(.crumbs)')].slice(1);
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -8% 0px' });
      for (const el of items) {
        el.classList.add('reveal');
        if (el.getBoundingClientRect().top < innerHeight) el.classList.add('in');
        else io.observe(el);
      }
      document.documentElement.classList.add('reveal-on');
    }
  </script>
</body>
</html>
